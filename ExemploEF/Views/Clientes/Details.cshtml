@model Cliente
@{ ViewData["Title"] = "Detalhes"; }
<h1>Detalhes de Cliente</h1><dl class="details"><dt>Nome</dt><dd>@Model.Nome</dd><dt>Email</dt><dd>@Model.Email</dd></dl><a class="button" asp-action="Edit" asp-route-id="@Model.ClienteId">Editar</a> <a class="button secondary" asp-action="Index">Voltar</a>