@model Produto
@{ ViewData["Title"] = "Create Produto"; }
<h1>Novo Produto</h1>
<form asp-action="Create"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Nome">Nome</label><input asp-for="Nome" /><span asp-validation-for="Nome" class="text-danger"></span>
<label asp-for="Descricao">Descrição</label><textarea asp-for="Descricao" rows="3"></textarea><span asp-validation-for="Descricao" class="text-danger"></span>
<label asp-for="Preco">Preço</label><input asp-for="Preco" type="number" step="0.01"/><span asp-validation-for="Preco" class="text-danger"></span>
<label asp-for="CategoriaId">Categoria</label><select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId"><option value="">Selecione uma categoria</option></select><span asp-validation-for="CategoriaId" class="text-danger"></span>
<div class="actions"><button type="submit">Salvar</button><a class="button secondary" asp-action="Index">Voltar</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }