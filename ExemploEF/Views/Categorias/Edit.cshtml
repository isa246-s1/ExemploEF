@model Categoria
@{ ViewData["Title"] = "Edit Categoria"; }
<h1>Editar Categoria</h1>
<form asp-action="Edit"><input type="hidden" asp-for="CategoriaId" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Nome">Nome</label><input asp-for="Nome" /><span asp-validation-for="Nome" class="text-danger"></span>
<div class="actions"><button type="submit">Salvar</button><a class="button secondary" asp-action="Index">Voltar</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }