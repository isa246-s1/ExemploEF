@model IEnumerable<Produto>
@{ ViewData["Title"] = "Produtos"; }
<div class="toolbar"><div><h1>Produtos</h1><p class="muted">Gerencie os registros cadastrados.</p></div><a class="button" asp-action="Create">Novo registro</a></div>
<table><thead><tr><th>Nome</th><th>Descrição</th><th>Preço</th><th>Categoria</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@item.Descricao</td><td>@item.Preco.ToString("C")</td><td>@item.Categoria.Nome</td><td><a asp-action="Details" asp-route-id="@item.ProdutoId">Detalhes</a><a asp-action="Edit" asp-route-id="@item.ProdutoId">Editar</a><a asp-action="Delete" asp-route-id="@item.ProdutoId">Excluir</a></td></tr> }</tbody></table>