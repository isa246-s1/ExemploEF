@model IEnumerable<Categoria>
@{ ViewData["Title"] = "Categorias"; }
<div class="toolbar"><div><h1>Categorias</h1><p class="muted">Gerencie os registros cadastrados.</p></div><a class="button" asp-action="Create">Novo registro</a></div>
<table><thead><tr><th>Nome</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Nome</td><td><a asp-action="Details" asp-route-id="@item.CategoriaId">Detalhes</a><a asp-action="Edit" asp-route-id="@item.CategoriaId">Editar</a><a asp-action="Delete" asp-route-id="@item.CategoriaId">Excluir</a></td></tr> }</tbody></table>