@model Cliente
@{ ViewData["Title"] = "Excluir"; }
<h1>Excluir Cliente</h1><div class="details"><p>Confirma a exclusão deste registro?</p><dl><dt>Nome</dt><dd>@Model.Nome</dd><dt>Email</dt><dd>@Model.Email</dd></dl></div><form asp-action="Delete" method="post"><input type="hidden" asp-for="ClienteId" /><button type="submit">Confirmar exclusão</button> <a class="button secondary" asp-action="Index">Cancelar</a></form>