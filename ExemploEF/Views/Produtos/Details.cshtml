@model Produto
@{ ViewData["Title"] = "Detalhes"; }
<h1>Detalhes de Produto</h1><dl class="details"><dt>Nome</dt><dd>@Model.Nome</dd><dt>Descrição</dt><dd>@Model.Descricao</dd><dt>Preço</dt><dd>@Model.Preco.ToString('C')</dd><dt>Categoria</dt><dd>@Model.Categoria?.Nome</dd></dl><a class="button" asp-action="Edit" asp-route-id="@Model.ProdutoId">Editar</a> <a class="button secondary" asp-action="Index">Voltar</a>